<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Modern Dashboard Panel Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="#334155">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- App Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp"
                android:text="Manage your ELPL application actions"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <!-- ELPL Toast Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnElpl"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:text="Show Toast"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#F59E0B"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

            <!-- Navigation Button: Second Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecond"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:text="Go to Read"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#3B82F6"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

            <!-- Navigation Button: Firebase Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThird"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:text="Go to Firebase Activity"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#10B981"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

            <!-- Navigation Button: Donate -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDonate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Donate to Test Project"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#8B5CF6"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

            <!-- Navigation Button: Donate -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/Chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chat Support"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#BE3A3A"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>