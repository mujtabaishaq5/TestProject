<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🔥 CRITICAL: Firebase needs internet access to receive pushes and write to the DB -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 🔥 OPTIONAL BUT RECOMMENDED: Required to show system-tray popups on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TestProject">

        <!-- 1. SPLASH SCREEN IS NOW THE LAUNCHER -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.TestProject"> <!-- Hides the top bar for the splash -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. MAIN ACTIVITY IS JUST A REGULAR SCREEN NOW -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TestProject"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. SECOND ACTIVITY -->
        <activity
            android:name=".secondActivity"
            android:theme="@style/Theme.TestProject"
            android:exported="false" />

        <activity
            android:name=".FirebaseActivity"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
            android:exported="false" />
        <activity
            android:name=".AiChatActivity"
            android:exported="false"
            android:theme="@style/Theme.TestProject"
            />

        <!-- Firebase Messaging Service -->
        <service
            android:name=".FirebaseMsgService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.syedm.testproject.widget.widgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/elpl_widget_info" />
        </receiver>

    </application>

</manifest>